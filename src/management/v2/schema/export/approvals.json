{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:approvals",
  "title": "ApprovalList",
  "description": "GET /v2/approvals[?state=all] and POST /v2/approvals/{id}/approve|deny → {approval}.",
  "anyOf": [{ "$ref": "#/$defs/approvalList" }, { "$ref": "#/$defs/approvalDecision" }],
  "$defs": {
    "approval": {
      "type": "object",
      "required": ["approvalId", "kind", "reason", "requesterCutexSessionId", "summary", "requestSha256", "state", "createdAt"],
      "properties": {
        "approvalId": { "type": "string" },
        "kind": { "enum": ["managed_service", "service_lifetime", "agent_profile", "ask_delivery", "browser_claim", "browser_open", "workflow_run", "static_root"] },
        "reason": { "type": "string" },
        "requesterCutexSessionId": { "type": "string" },
        "requesterName": { "type": "string" },
        "projectId": { "type": "string" },
        "summary": { "type": "string" },
        "details": {},
        "requestSha256": { "type": "string" },
        "state": { "enum": ["pending", "approved", "denied", "consumed", "expired"] },
        "createdAt": { "type": "string" },
        "decidedAt": { "type": "string" },
        "note": { "type": "string" },
        "decidedBy": { "$ref": "#/$defs/approvalDecider" },
        "consumedAt": { "type": "string" },
        "wait": { "$ref": "#/$defs/approvalWait" },
        "risk": { "enum": ["low", "medium", "high"] },
        "matchedRuleId": { "type": "string" },
        "autoDecision": { "type": "boolean" },
        "ruleRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "approvalDecider": {
      "description": "approval-decided-by: who decided. `by` = owner (root credential) or auto:<reason>; `client` = the client's own unverified facts.",
      "type": "object",
      "required": ["by"],
      "properties": {
        "by": { "type": "string" },
        "connection": { "enum": ["loopback", "remote"] },
        "peer": { "type": "string" },
        "client": {
          "type": "object",
          "properties": {
            "app": { "type": "string" },
            "version": { "type": "string" },
            "device": { "type": "string" },
            "surface": { "type": "string" },
            "input": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "approvalWait": {
      "description": "approval-wait: the requesting tool call holds for the owner's decision until `until`; `end` once the hold ended.",
      "type": "object",
      "required": ["id", "startedAt", "until"],
      "properties": {
        "id": { "type": "string" },
        "startedAt": { "type": "string" },
        "until": { "type": "string" },
        "threadId": { "type": "string" },
        "turnId": { "type": "string" },
        "endedAt": { "type": "string" },
        "end": { "enum": ["approved", "denied", "timeout", "disconnected", "turn_ended", "runtime_changed"] }
      }
    },
    "approvalList": {
      "type": "object",
      "required": ["hostId", "approvals"],
      "properties": {
        "hostId": { "type": "string" },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } }
      }
    },
    "approvalDecision": {
      "type": "object",
      "required": ["approval"],
      "properties": { "approval": { "$ref": "#/$defs/approval" } }
    }
  }
}
