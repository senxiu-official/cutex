{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:asks",
  "title": "AskList",
  "description": "GET /v2/asks summaries. Owner cleanup pagination (asks-updated-before-cursor-v1) adds updatedBefore RFC3339 and opaque cursor, orders by updatedAt then askId ascending, and returns nextCursor. Keep filters and cutoff unchanged between pages. Without these parameters legacy order is unchanged. Short-ID lookup (asks-short-id-lookup-v1) adds idPrefix and returns lightweight hits. GET /v2/asks/{id} returns {ask} with owner detail.",
  "anyOf": [
    {
      "$ref": "#/$defs/askList"
    },
    {
      "$ref": "#/$defs/askDetail"
    },
    {
      "$ref": "#/$defs/askShortIdLookup"
    }
  ],
  "$defs": {
    "crossHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "peer", "receipt"],
      "properties": {
        "direction": {"enum": ["inbound", "outbound"]},
        "peer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instanceId", "label"],
          "properties": {"instanceId": {"type": "string", "pattern": "^ci-[0-9a-fA-F]{32}$"}, "label": {"type": "string"}}
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason", "confirmedAt"],
          "properties": {
            "state": {"enum": ["queuedAtSource", "deliveredToPeer", "accepted", "failed", "outcomeUnknown"]},
            "reason": {"enum": [null, "sourceRoutingRefused", "destinationRoutingRefused", "peerRefusedUnspecified", "peerUnreachable", "peerCredentialRefused", "peerIdentityChanged", "peerVersionMismatch", "peerRemoved", "peerDisabled", "peerRejectedRequest", "destinationRejected", "destinationFailed", "cancelled", "interrupted", "outcomeUnknown"]},
            "confirmedAt": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      }
    },
    "reviewReference": {
      "type": "object",
      "required": ["kind", "approvalId", "projectId"],
      "properties": {
        "kind": {"enum": ["routing", "capability"]},
        "approvalId": {"type": "string", "minLength": 1},
        "projectId": {"type": ["string", "null"]}
      }
    },
    "requester": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "owner",
            "peer"
          ]
        },
        "peer": {
          "type": "object",
          "required": [
            "peerId",
            "label"
          ],
          "properties": {
            "peerId": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "cutexSessionId": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "peerId": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "Single-line sanitized display label."
        },
        "claimedCaps": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sandbox": {
              "type": [
                "string",
                "null"
              ]
            },
            "networkAccess": {
              "type": "boolean"
            },
            "unrestrictedServices": {
              "type": "boolean"
            }
          },
          "description": "Capabilities claimed by the remote requester; display only, never approval authority."
        }
      }
    },
    "askSummary": {
      "type": "object",
      "required": [
        "askId",
        "title",
        "requester",
        "target",
        "execution",
        "createdAt"
      ],
      "properties": {
        "askId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "crossHost": {"$ref": "#/$defs/crossHost"},
        "controller": {
          "type": ["string", "null"],
          "description": "Current scoped controller after handover; null while review or reconciliation prevents control. Omitted for ordinary r253 ownership."
        },
        "originallyRequestedBy": {
          "type": ["string", "null"],
          "description": "Immutable original local requester; it is not rewritten when control moves."
        },
        "controlError": {
          "type": "string",
          "description": "Why handover control is currently unavailable; no control is granted when present."
        },
        "controlHistorical": {"type":"boolean","description":"Terminal work shows historical attribution only; this does not grant current control."},
        "target": {
          "type": "string",
          "description": "target cutexSessionId"
        },
        "targetName": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "$ref": "#/$defs/remote"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "admissionFailure": {
          "type": "string",
          "minLength": 1,
          "description": "Exact permanent pre-dispatch refusal code, including zero-attempt failures; omitted on older records and when absent."
        },
        "execution": {
          "type": "string",
          "description": "queued | admitted | running | pendingReview | interrupted | answered | failed | rejected | cancelled | …"
        },
        "continuationWait": {
          "$comment": "r290 P14",
          "description": "Non-null for an open yielded delegation: show this waiting phase instead of running and its ended attempt duration. nextWakeAt is a planned UTC timer time, not a deadline; render in the owner's locale. Older hosts omit this field.",
          "type": ["object", "null"],
          "required": ["state", "kind", "since", "nextWakeAt"],
          "additionalProperties": false,
          "properties": {
            "state": {"type": "string", "enum": ["waiting", "ready", "limited"]},
            "kind": {"type": "string", "enum": ["after", "children", "jobs"]},
            "since": {"type": ["string", "null"]},
            "nextWakeAt": {"type": ["string", "null"]},
            "blockedReason": {
              "type": "string",
              "enum": ["quota", "login", "runtimeDown", "budget", "runtimeOffline", "reconnecting", "paused", "planMode", "profileSwitchPending", "targetBusy", "admission", "routing", "runtimeUnsupported", "reconciling"]
            }
          }
        },
        "hold": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "description": "Includes peerUnreachable, peerIdentityChanged, peerVersionMismatch and peerUnknown. Unknown peer state is display-only and never drives local scheduling."
            },
            "raw": {
              "type": "string"
            }
          }
        },
        "holdSince": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "type": [
            "string",
            "null"
          ],
          "description": "awaitingAcceptance | accepted | changesRequested | abandoned"
        },
        "reviewRef": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/reviewReference"}],
          "description": "Typed approval reference; routing takes precedence. The existing review acceptance state is unchanged."
        },
        "reviewRefs": {
          "type": "array", "items": {"$ref": "#/$defs/reviewReference"},
          "description": "Independent routing and capability reviews; deciding one never bypasses the other."
        },
        "reviewDenialReason": {"type": ["string", "null"]},
        "activityLink": {
          "type": "object",
          "description": "Current delegation blocker and navigation references. These links confer no action authority.",
          "properties": {
            "delegation": {
              "type": "object",
              "required": ["kind", "askId"],
              "properties": {"kind": {"const": "delegation"}, "askId": {"type": "string"}}
            },
            "approval": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reviewReference"}]},
            "result": {
              "type": ["object", "null"],
              "required": ["kind", "askId", "answerId"],
              "properties": {
                "kind": {"const": "delegationResult"}, "askId": {"type": "string"}, "answerId": {"type": "string"}
              }
            },
            "blocker": {"type": ["string", "null"]},
            "next": {"type": "string"}
          },
          "required": ["delegation", "approval", "result", "blocker", "next"]
        },
        "closed": {
          "type": [
            "string",
            "null"
          ],
          "description": "completed | accepted | abandoned | stopped | cancelled | superseded"
        },
        "followUpEnded": {"type": "boolean", "description": "Owner ended tracking without asserting execution stopped."},
        "queuePosition": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Management asks list and detail report the one-based position in the target's numbered admission queue, including owner inputs, or null if the delegation has no numbered row. Internal ask summaries and delegation tools use creation order among local queued delegations for the same target. The owner close receipt returns null."
        },
        "attempts": {
          "type": "integer"
        },
        "answerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "openQuestions": {
          "type": "integer"
        },
        "attempt": {
          "type": [
            "object",
            "null"
          ],
          "properties": {"startedAtInferred": {"const": true, "description": "Optional. startedAt is the time exact native input history proved the start, not the original start notification time. Absent on old or unmarked records; absence does not prove exact timing."}, "stopDeadline": {"type": ["string", "null"]}, "stopUnconfirmed": {"type": "boolean"}, "steps": {"type": ["object", "null"], "properties": {"done": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "currentStep": {"type": ["string", "null"]}}}, "lastProgressAt": {"type": ["string", "null"]}}
        },
        "closedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "followUpOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerQuestions": {
          "type": "integer"
        },
        "answerPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "await": {
          "type": [
            "object",
            "null"
          ],
          "properties": {"canResume": {"type": "boolean", "description": "The local handler has yielded and the owner may request resumption through cutex/ask/resume."}},
          "description": "The handler yielded to wait for jobs (hold waitingForEvent): {jobs, until: all|any, resume: all|each, since, timeoutAt, note, attempt, canResume}"
        },
        "resume": {
          "type": [
            "object",
            "null"
          ],
          "description": "Woken, waiting for admission of the continuation: {reason: jobs|jobFailed|timeout|resumed|reopened, since, by}"
        },
        "jobs": {
          "type": "array",
          "description": "Job Service jobs bound to the delegation",
          "items": {
            "type": "object",
            "required": [
              "jobId",
              "status"
            ],
            "properties": {
              "jobId": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "auto",
                  "explicit"
                ]
              },
              "status": {
                "type": "string",
                "description": "running | exited | failed | cancelled | interrupted | launchUnknown"
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ok": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "cancel": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "pending | sent | failed | notRunning"
              }
            }
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "level": {
                "enum": [
                  "sent",
                  "delivered",
                  "inContext",
                  "acknowledged"
                ]
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sentAt": {
                "type": "string"
              },
              "acknowledgedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "supersededBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "hops": {
          "type": "integer",
          "minimum": 0
        },
        "lateAnswer": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "text": false,
            "lastError": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "description": "Sanitized single-line diagnostic, at most 512 UTF-8 bytes."
            },
            "artifactId": {
              "type": [
                "string",
                "null"
              ]
            },
            "preview": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Late answer metadata with local artifactId and bounded preview; no inline text and no new delivery."
        },
        "resultUndeliverable": {
          "type": "boolean"
        },
        "interruptReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "askList": {
      "type": "object",
      "required": [
        "hostId",
        "asks",
        "hasMore"
      ],
      "properties": {
        "hostId": {
          "type": "string"
        },
        "asks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/askSummary"
          }
        },
        "hasMore": {
          "type": "boolean"
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Present in updatedBefore cleanup mode only. Percent-encode when sending as the next cursor."
        }
      }
    },
    "askShortIdLookup": {
      "type": "object",
      "required": ["hostId", "asks", "hasMore"],
      "properties": {
        "hostId": {"type": "string"},
        "asks": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/askShortIdHit"}
        },
        "hasMore": {"type": "boolean"}
      }
    },
    "askShortIdHit": {
      "type": "object",
      "required": ["askId", "title", "target", "targetName", "projectId", "execution", "closed", "updatedAt"],
      "properties": {
        "askId": {"type": "string", "pattern": "^ask-[0-9a-fA-F]{32}$"},
        "title": {"type": "string"},
        "target": {"type": "string"},
        "targetName": {"type": ["string", "null"]},
        "projectId": {"type": ["string", "null"]},
        "execution": {"type": "string"},
        "closed": {"type": ["string", "null"]},
        "updatedAt": {"type": "string"}
      }
    },
    "askDetail": {
      "type": "object",
      "required": [
        "ask"
      ],
      "properties": {
        "ask": {
          "type": "object",
          "properties": {
            "admissionFailure": { "type": "string", "minLength": 1, "description": "Exact permanent pre-dispatch refusal code; no attempt is invented." },
            "crossHost": {"$ref": "#/$defs/crossHost"},
            "controller": { "type": ["string", "null"] },
            "originallyRequestedBy": { "type": ["string", "null"] },
            "controlError": { "type": "string" },
            "controlHistorical": {"type":"boolean"}
          }
        }
      }
    },
    "remote": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "peerId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "targetName": {
          "type": "string"
        },
        "syncState": {
          "type": "string"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "description": "Sanitized single-line diagnostic, at most 512 UTF-8 bytes."
        },
        "interruptReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteState": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "text": false,
            "lastError": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "description": "Sanitized single-line diagnostic, at most 512 UTF-8 bytes."
            }
          },
          "description": "Portable peer snapshot metadata; answer text is omitted. Unknown state strings are retained."
        },
        "lateAnswer": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "text": false,
            "lastError": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512,
              "description": "Sanitized single-line diagnostic, at most 512 UTF-8 bytes."
            },
            "artifactId": {
              "type": [
                "string",
                "null"
              ]
            },
            "preview": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Late answer metadata with local artifactId and bounded preview; no inline text and no new delivery."
        }
      }
    }
  }
}
