{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:baidu-pan",
  "title": "Host Baidu Pan connection and downloads",
  "description": "Capability baidu-pan / baiduPan. Owner API /v2/pan; authenticated agent CLI /api/pan/v1. No upload/delete. Dedicated SSE event pan.download carries progressEvent; snapshot downloads after reconnect. Secrets never returned.",
  "anyOf": [
    {
      "$ref": "#/$defs/connection"
    },
    {
      "$ref": "#/$defs/file"
    },
    {
      "$ref": "#/$defs/download"
    },
    {
      "$ref": "#/$defs/start"
    },
    {
      "$ref": "#/$defs/application"
    },
    {
      "$ref": "#/$defs/progressEvent"
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "id",
        "name",
        "vipType"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vipType": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": [
        "configured",
        "state",
        "appId",
        "clientId",
        "account",
        "expiresAt"
      ],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "disconnected",
            "needsAuth",
            "connected"
          ]
        },
        "appId": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": [
            "string",
            "null"
          ]
        },
        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "id",
        "path",
        "name",
        "isDir",
        "size",
        "modifiedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "isDir": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modifiedAt": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "download": {
      "type": "object",
      "required": [
        "id",
        "requestId",
        "remote",
        "targetDir",
        "targetPath",
        "state",
        "downloadedBytes",
        "totalBytes",
        "bytesPerSecond",
        "caller",
        "createdAt",
        "updatedAt",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "targetDir": {
          "type": "string"
        },
        "targetPath": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "downloading",
            "paused",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "downloadedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "bytesPerSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "caller": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "owner",
                "agent"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "required": [
        "requestId",
        "remote",
        "targetDir"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "remote": {
          "type": "string"
        },
        "targetDir": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "required": [
        "appId",
        "clientId",
        "clientSecret"
      ],
      "properties": {
        "appId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string",
          "writeOnly": true
        }
      },
      "additionalProperties": false
    },
    "progressEvent": {
      "type": "object",
      "required": [
        "download"
      ],
      "properties": {
        "download": {
          "$ref": "#/$defs/download"
        }
      },
      "additionalProperties": false
    }
  }
}
