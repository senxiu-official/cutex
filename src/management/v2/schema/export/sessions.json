{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:sessions",
  "title": "SessionList",
  "description": "GET /v2/sessions (and GET /v2/sessions/{id} → one session). Fields not listed may be added in later versions.",
  "anyOf": [{ "$ref": "#/$defs/sessionList" }, { "$ref": "#/$defs/session" }],
  "$defs": {
    "sessionList": {
      "type": "object",
      "required": ["contractVersion", "hostId", "sessions"],
      "properties": {
        "contractVersion": { "const": 2 },
        "hostId": { "type": "string" },
        "management": {},
        "claudeRuntime": {
          "type": "object",
          "description": "Capability session-claude-runtime: the Claude runtime the host uses for new Claude sessions. Compare with each Claude session's runtime.claudeRuntime to offer an upgrade (POST /v2/sessions/{id}/claude-runtime/repin).",
          "required": ["selectedRelease"],
          "properties": {
            "selectedRelease": { "type": ["string", "null"], "description": "Runtime directory label such as claude-r19; null when no usable Claude runtime is installed." }
          }
        },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } }
      }
    },
    "appServerSchema": {
      "type": "object",
      "required": ["protocol", "version"],
      "properties": {
        "protocol": { "type": "string", "description": "codex-app-server | claude-app-server-subset" },
        "majorVersion": { "type": "integer" },
        "version": { "type": "string" },
        "sha256": { "type": ["string", "null"], "description": "null for Claude sessions (claude-app-server-subset)." },
        "channel": { "type": "string" },
        "capabilities": {},
        "extensions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["status", "runtimeGeneration"],
      "properties": {
        "backend": { "type": "string" },
        "status": { "type": "string", "description": "online | offline | error | …" },
        "appServerConnected": { "type": "boolean" },
        "runtimeGeneration": { "type": "integer", "minimum": 0 },
        "runtimeAgentId": { "type": ["string", "null"] },
        "activeTurnId": { "type": ["string", "null"] },
        "activeTurnObservedAt": { "type": ["string", "null"] },
        "threadStatus": {},
        "threadSettings": { "type": ["object", "null"] },
        "requiresVisibleTerminal": { "type": "boolean" },
        "tuiAttached": { "type": "boolean" },
        "lastEventAt": { "type": ["string", "null"] },
        "lastError": {},
        "pendingServerRequests": {
          "type": "array",
          "description": "Capability session-pending-server-requests: native server requests (approvals, questions, ...) of this runtime generation still waiting for an answer, oldest first; the full message is in GET /v2/sessions/{id}/bootstrap pendingServerRequests. Empty when none.",
          "items": {
            "type": "object",
            "required": ["id", "method"],
            "properties": {
              "id": { "type": ["string", "integer"] },
              "method": { "type": "string" }
            }
          }
        },
        "claudeRuntime": {
          "type": "object",
          "description": "Capability session-claude-runtime; Claude sessions only (absent on others): the pinned Claude runtime and a repin saved for the next fresh runtime start (claude-runtime.json).",
          "required": ["release", "pendingRelease"],
          "properties": {
            "release": { "type": "string", "description": "Runtime directory label such as claude-r17, never a path." },
            "pendingRelease": { "type": ["string", "null"], "description": "A deferred repin's release (applies at the next fresh runtime start); null when none." }
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["emoji", "color", "icon"] },
        "value": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$", "description": "Capability agent-avatar-color: circle colour of an emoji / icon avatar (a color avatar keeps its colour in value)." }
      }
    },
    "session": {
      "type": "object",
      "required": ["contractVersion", "cutexSessionId", "revision", "lifecycle", "hostId", "displayName", "runtime"],
      "properties": {
        "contractVersion": { "const": 2 },
        "cutexSessionId": { "type": "string" },
        "revision": { "type": "integer" },
        "lifecycle": { "enum": ["active", "retired"] },
        "retiredAt": { "type": ["string", "null"] },
        "hostId": { "type": "string" },
        "displayName": { "type": "string" },
        "formalAgentName": { "type": ["string", "null"] },
        "displayNameOverride": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "avatar": { "anyOf": [{ "$ref": "#/$defs/avatar" }, { "type": "null" }] },
        "claudeAccount": {
          "type": "object",
          "description": "Claude sessions only (capability claude-accounts): the account the session was created on (claude-accounts.json#/$defs/sessionAccount).",
          "required": ["id", "label", "kind", "isDefault"],
          "properties": {
            "id": { "type": "string" },
            "label": { "type": ["string", "null"] },
            "kind": { "enum": ["subscription", "api", "removed"] },
            "isDefault": { "type": "boolean" }
          }
        },
        "threadName": { "type": ["string", "null"] },
        "cwd": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "configuredProfile": { "type": ["string", "null"] },
        "launchedProfile": { "type": ["string", "null"] },
        "effectiveNextLaunch": { "type": "object" },
        "groups": { "type": "array", "items": { "type": "string" } },
        "registrationClass": {},
        "visible": { "type": "boolean" },
        "native": {
          "type": "object",
          "properties": {
            "threadId": { "type": ["string", "null"] },
            "schema": { "anyOf": [{ "$ref": "#/$defs/appServerSchema" }, { "type": "null" }] }
          }
        },
        "runtime": { "$ref": "#/$defs/runtime" },
        "runtimeDefaults": { "type": ["object", "null"] },
        "activity": { "type": ["object", "null"] },
        "focus": {},
        "management": {},
        "createdAt": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"] }
      }
    }
  }
}
