{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:services",
  "title": "Services",
  "anyOf": [
    {
      "$ref": "#/$defs/eligibleOwners"
    },
    {
      "$ref": "#/$defs/serviceList"
    },
    {
      "$ref": "#/$defs/lease"
    },
    {
      "$ref": "#/$defs/viewTicket"
    },
    {
      "type": "object",
      "required": [
        "service"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/service"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/settings"
        }
      }
    },
    {
      "$ref": "#/$defs/tileAnswer"
    }
  ],
  "$defs": {
    "eligibleOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "realName", "projectId", "isDirector", "online", "unnamed"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "realName": {"type": "string"},
        "projectId": {"type": ["string", "null"]},
        "isDirector": {"type": "boolean"},
        "online": {"type": "boolean"},
        "unnamed": {"type": "boolean"}
      }
    },
    "eligibleOwners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "slug", "owners"],
      "properties": {
        "hostId": {"type": "string"},
        "slug": {"type": "string"},
        "owners": {
          "type": "array",
          "items": {"$ref": "#/$defs/eligibleOwner"}
        }
      }
    },
    "viewTicketRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "start": {
          "type": "boolean"
        },
        "routing": {
          "const": "host"
        },
        "login": {
          "type": "boolean"
        }
      }
    },
    "viewTicket": {
      "type": "object",
      "required": [
        "ticket",
        "expiresAt",
        "hostLabel",
        "authPath"
      ],
      "properties": {
        "ticket": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "hostLabel": {
          "type": "string"
        },
        "login": {
          "enum": [
            "issued",
            "notRunning",
            "spawnFailed",
            "timeout",
            "exitStatus",
            "noLink"
          ]
        },
        "authPath": {
          "type": "string"
        }
      }
    },
    "proxySettings": {
      "type": "object",
      "properties": {
        "proxyMaxConnections": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024,
          "default": 192
        }
      }
    },
    "proxyView": {
      "type": "object",
      "required": [
        "proxyHost",
        "proxyHostHeader",
        "activeConnections",
        "lastTrafficAt"
      ],
      "properties": {
        "proxyHost": {
          "type": "string"
        },
        "proxyHostHeader": {
          "enum": [
            "preserve",
            "upstream"
          ]
        },
        "activeConnections": {
          "type": "integer",
          "minimum": 0
        },
        "lastTrafficAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "slug",
        "displayName",
        "host",
        "port",
        "runtime",
        "lifetime",
        "link",
        "url",
        "localUrl",
        "health",
        "proxyHost",
        "proxyHostHeader",
        "activeConnections",
        "lastTrafficAt"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        },
        "runtime": {
          "enum": [
            "external",
            "managed",
            "static"
          ]
        },
        "lifetime": {
          "enum": [
            "ephemeral",
            "persistent"
          ]
        },
        "purpose": {
          "description": "Persistent-service purpose. Known values are foreground and background; clients treat other strings as uncategorised.",
          "type": [
            "string",
            "null"
          ]
        },
        "idleTtlMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 5
        },
        "effectiveIdleTtlMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 5
        },
        "maxIdleTtlMinutes": {
          "type": "integer",
          "minimum": 60
        },
        "pinned": {
          "type": "boolean",
          "default": false
        },
        "groupName": {
          "type": [
            "string",
            "null"
          ]
        },
        "starred": {
          "type": "boolean",
          "default": false
        },
        "sortOrder": {
          "type": "integer",
          "default": 0
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "archived": {
          "type": "boolean",
          "default": false
        },
        "archivedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": "string"
        },
        "proxyHost": {
          "type": "string"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "localUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "leases": {
          "type": "integer",
          "minimum": 0
        },
        "activeConnections": {
          "type": "integer",
          "minimum": 0
        },
        "lastTrafficAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "idleReclaimAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "restartsLeft": {
          "type": [
            "integer",
            "null"
          ]
        },
        "health": {
          "enum": [
            "reachable",
            "unreachable",
            "starting",
            "stopped",
            "crashLooped"
          ]
        },
        "proxyHostHeader": {
          "enum": [
            "preserve",
            "upstream"
          ]
        },
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "tilePath": {
          "$ref": "#/$defs/tilePath"
        },
        "ownerCutexSessionId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The registering cutex session (session services: their only agent manager)."
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerScope": {
          "enum": [
            "session",
            "project"
          ],
          "description": "Capability services-project-scope. Absent on older hosts: session. project: also managed by the current Director of projectId and by the registrant while in that project."
        }
      }
    },
    "tombstone": {
      "type": "object",
      "required": [
        "slug",
        "displayName",
        "ownerCutexSessionId",
        "lifetime",
        "reason",
        "reclaimedAt"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "ownerCutexSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifetime": {
          "enum": [
            "ephemeral",
            "persistent"
          ]
        },
        "reason": {
          "enum": [
            "idle",
            "ttl",
            "owner_archived",
            "project_archived"
          ]
        },
        "reclaimedAt": {
          "type": "string"
        }
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "leaseId",
        "expiresAt",
        "ttlSeconds"
      ],
      "properties": {
        "leaseId": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "ttlSeconds": {
          "const": 150
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "portRangeStart",
        "portRangeEnd",
        "ephemeralIdleMinutes",
        "ephemeralTtlHours",
        "reclaimOnOwnerArchive",
        "tombstoneDays",
        "ephemeralMaxRestarts",
        "proxyMaxConnections",
        "agentExternalDefaultLifetime",
        "agentPersistentApproval"
      ],
      "properties": {
        "portRangeStart": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "portRangeEnd": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "ephemeralIdleMinutes": {
          "description": "Default idle TTL; 0 keeps ephemeral services until their owner is archived.",
          "anyOf": [
            { "const": 0 },
            { "type": "integer", "minimum": 5, "maximum": 1440 }
          ],
          "default": 30
        },
        "ephemeralTtlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720,
          "default": 24
        },
        "reclaimOnOwnerArchive": {
          "type": "boolean",
          "default": true
        },
        "tombstoneDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90,
          "default": 7
        },
        "ephemeralMaxRestarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        },
        "proxyMaxConnections": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024,
          "default": 192
        },
        "agentExternalDefaultLifetime": {
          "enum": [
            "ephemeral",
            "persistent"
          ],
          "default": "ephemeral"
        },
        "agentPersistentApproval": {
          "enum": [
            "ask",
            "off"
          ],
          "default": "ask"
        }
      }
    },
    "serviceList": {
      "type": "object",
      "required": [
        "hostId",
        "services",
        "settings"
      ],
      "properties": {
        "hostId": {
          "type": "string"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tombstone"
          }
        }
      }
    },
    "tilePath": {
      "type": "string",
      "pattern": "^/([^/\\s\\\\#][^\\s\\\\#]*)?$",
      "maxLength": 512
    },
    "tile": {
      "type": "object",
      "description": "A validated home page tile template (capability service-tiles). Paths are inside the service.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lines": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "image": {
          "$ref": "#/$defs/tilePath"
        },
        "progress": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "badge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "label",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "path": {
                "$ref": "#/$defs/tilePath"
              }
            }
          }
        },
        "refreshSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "sizes": {
          "type": "array",
          "items": {
            "enum": [
              "s",
              "m",
              "w",
              "l"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "tileAnswer": {
      "type": "object",
      "description": "GET /v2/services/{slug}/tile",
      "required": [
        "tile",
        "fetchedAt",
        "error",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "tile": {
          "anyOf": [
            {
              "$ref": "#/$defs/tile"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "service_stopped",
                    "unreachable",
                    "timeout",
                    "too_large",
                    "not_found",
                    "http_status",
                    "redirect_outside_service",
                    "too_many_redirects",
                    "invalid_response",
                    "invalid_json",
                    "invalid_tile"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "source": {
          "enum": [
            "static",
            "service"
          ]
        }
      }
    }
  }
}
