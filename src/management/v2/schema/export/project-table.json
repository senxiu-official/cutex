{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:cutex:management-v2:project-table",
  "title":"Project table summaries and owner lifecycle batches",
  "$defs":{
    "projectStats":{"type":"object","required":["last_activity_at","online_member_count"],"properties":{
      "last_activity_at":{"type":["string","null"],"format":"date-time"},
      "online_member_count":{"type":["integer","null"],"minimum":0}
    }},
    "batchRequest":{"type":"object","additionalProperties":false,"required":["requestId","action","items"],"properties":{
      "requestId":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[A-Za-z0-9_.-]+$"},
      "action":{"enum":["archive","restore"]},
      "items":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","additionalProperties":false,
        "required":["projectId","expectedRevision"],"properties":{
          "projectId":{"type":"string","minLength":1},
          "expectedRevision":{"type":"integer","minimum":0,"maximum":9007199254740991}
        }}}
    }},
    "batchItem":{"type":"object","required":["projectId","status"],"properties":{
      "projectId":{"type":"string"},"status":{"type":"integer","minimum":200,"maximum":599},
      "result":{"type":"object","description":"Unmodified single-project mutation receipt"},
      "error":{"type":"object","required":["code","message","retryable"],"properties":{
        "code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"}
      }}
    },"oneOf":[{"required":["result"],"properties":{"status":{"const":200}}},{"required":["error"]}]},
    "batchResponse":{"type":"object","required":["contractVersion","requestId","atomic","items"],"properties":{
      "contractVersion":{"const":1},"requestId":{"type":"string"},"atomic":{"const":false},
      "items":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/batchItem"}}
    }}
  }
}
