{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:error",
  "title": "CutexErrorBody",
  "description": "Management v2 error envelope (every non-2xx JSON response) and the SSE `cutex_management_stream_error` frame data.",
  "$ref": "#/$defs/errorBody",
  "$defs": {
    "errorBody": {
      "type": "object",
      "required": ["contractVersion", "error"],
      "properties": {
        "contractVersion": { "const": 2 },
        "error": {
          "type": "object",
          "required": ["source", "code", "message", "retryable"],
          "properties": {
            "source": { "type": "string" },
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "diagnosticId": { "type": "string" },
            "details": {}
          },
          "allOf": [
            {
              "if": { "properties": { "code": { "const": "pinned_model_selection_unavailable" } } },
              "then": {
                "required": ["details"],
                "properties": {
                  "retryable": { "const": false },
                  "details": { "$ref": "#/$defs/pinnedModelSelectionUnavailable" }
                }
              }
            },
            {
              "if": { "properties": { "code": { "const": "pinned_model_selection_upgrade_required" } } },
              "then": {
                "required": ["details"],
                "properties": {
                  "retryable": { "const": false },
                  "details": { "$ref": "#/$defs/pinnedModelSelectionUpgradeRequired" }
                }
              }
            }
          ]
        }
      }
    },
    "pinnedModelSelectionUnavailable": {
      "description": "HTTP 409 when model or effort evidence explicitly rejects the saved or requested selection.",
      "type": "object",
      "required": ["model", "reasoningEffort", "reason", "offeredReasoningEfforts"],
      "properties": {
        "model": { "type": "string" },
        "reasoningEffort": { "type": ["string", "null"] },
        "reason": { "enum": ["modelUnavailable", "effortUnavailable"] },
        "offeredReasoningEfforts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pinnedModelSelectionUpgradeRequired": {
      "description": "HTTP 409 when the pinned Claude runtime lacks the capability required to save or apply an offline launch selection.",
      "type": "object",
      "required": ["requiredCapability"],
      "properties": {
        "requiredCapability": { "const": "offlineLaunchSelection" }
      }
    }
  }
}
